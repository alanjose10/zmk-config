if SHIELD_HILLSIDE46MAC_LEFT || SHIELD_HILLSIDE46MAC_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_HILLSIDE46MAC_DONGLE

# Max 16 characters in keyboard name
config ZMK_KEYBOARD_NAME
    default "Hillside46 Mac"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
