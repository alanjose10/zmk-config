config BOARD_NRF52840_MDK_USB_DONGLE
	select ZMK_BOARD_COMPAT if BOARD_NRF52840_MDK_USB_DONGLE_NRF52840_ZMK
	# Lets &bootloader / &dongle_bootloader reboot into the UF2 bootloader via GPREGRET magic.
	imply RETAINED_MEM if BOARD_NRF52840_MDK_USB_DONGLE_NRF52840_ZMK
	imply RETENTION if BOARD_NRF52840_MDK_USB_DONGLE_NRF52840_ZMK
	imply RETENTION_BOOT_MODE if BOARD_NRF52840_MDK_USB_DONGLE_NRF52840_ZMK
